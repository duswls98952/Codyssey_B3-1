# B3-1 실습 기록 (IP 가림 사본)
# 날짜: 2026-11-10 · 로컬 Mac(AWS CLI 2.38.5, 프로필 b3-1, 리전 ap-northeast-2) / EC2(ec2-user@ip-10-0-1-14)
# "$ "로 시작하는 줄은 로컬 Mac 명령, "[ec2-user@ip-10-0-1-14 ~]$ "로 시작하는 줄은 EC2 안 명령이다.
# "# (보고)"는 출력 원문 대신 학습자가 결과를 알려 준 줄이고, "# 캡처:"는 같은 결과의 스크린샷 파일이다.
# 표(--output table) 출력은 테두리 줄을 생략하고 값이 있는 행만 옮겼다. 원본 화면은 캡처 파일에 있다.
# VPC(vpc-0d4141c709a455f42, 10.0.0.0/16)는 이전 세션에 만들었다.

## 0. 로그인과 실행 주체 확인
$ aws login --profile b3-1
# (보고) 브라우저에서 IAM 사용자 Yeonjin_IAM으로 로그인
$ aws sts get-caller-identity --profile b3-1 --output table
|  Account      |  Arn                                          |  UserId                 |
|  503440159666 |  arn:aws:iam::503440159666:user/Yeonjin_IAM   |  AIDAXKN27GOZKMFPDW5XM  |
# 캡처: docs/screenshots/iam-identity.png

## 1. 기존 상태 조회와 Public Subnet 생성
$ aws ec2 describe-vpcs --profile b3-1 \
    --vpc-ids vpc-0d4141c709a455f42 \
    --query 'Vpcs[].[VpcId,CidrBlock,State,Tags[?Key==`Name`]|[0].Value]' \
    --output table
# (보고) vpc-0d4141c709a455f42 | 10.0.0.0/16 | available | b3-1-vpc
$ aws ec2 describe-subnets --profile b3-1 \
    --filters Name=vpc-id,Values=vpc-0d4141c709a455f42 \
    --query 'Subnets[].[SubnetId,CidrBlock,AvailabilityZone,State,Tags[?Key==`Name`]|[0].Value]' \
    --output table
# (보고) 출력 없음 → 이 VPC에 Subnet이 아직 없음
$ aws ec2 create-subnet \
    --profile b3-1 \
    --vpc-id vpc-0d4141c709a455f42 \
    --cidr-block 10.0.1.0/24 \
    --availability-zone ap-northeast-2a \
    --tag-specifications 'ResourceType=subnet,Tags=[{Key=Name,Value=b3-1-public-subnet},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'Subnet.[SubnetId,CidrBlock,AvailabilityZone,State]' \
    --output table
|        CreateSubnet        |
|  subnet-076006b93227230ea  |
|  10.0.1.0/24               |
|  ap-northeast-2a           |
|  available                 |

## 2. Internet Gateway 생성과 VPC 연결
$ aws ec2 create-internet-gateway \
    --profile b3-1 \
    --tag-specifications 'ResourceType=internet-gateway,Tags=[{Key=Name,Value=b3-1-igw},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'InternetGateway.[InternetGatewayId,Attachments]' \
    --output table
aws: [ERROR]: Row should have 1 elements, instead it has 0
# 재실행하지 않고 조회로 실제 상태 확인 (트러블슈팅 사례 1)
$ aws ec2 describe-internet-gateways --profile b3-1 \
    --filters Name=tag:Name,Values=b3-1-igw \
    --query 'InternetGateways[].{ID:InternetGatewayId,Attached:length(Attachments)}' \
    --output table
| Attached |          ID            |
|  0       |  igw-011ba32fd601177ce |
# 캡처: docs/screenshots/troubleshooting-igw-table-error.png
$ aws ec2 attach-internet-gateway \
    --profile b3-1 \
    --internet-gateway-id igw-011ba32fd601177ce \
    --vpc-id vpc-0d4141c709a455f42
$ aws ec2 describe-internet-gateways --profile b3-1 \
    --internet-gateway-ids igw-011ba32fd601177ce \
    --query 'InternetGateways[].Attachments[].[VpcId,State]' \
    --output table
# (보고) vpc-0d4141c709a455f42 | available

## 3. Route Table 생성, 기본 경로 추가, Subnet 연결
$ aws ec2 create-route-table \
    --profile b3-1 \
    --vpc-id vpc-0d4141c709a455f42 \
    --tag-specifications 'ResourceType=route-table,Tags=[{Key=Name,Value=b3-1-public-rt},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'RouteTable.RouteTableId' \
    --output text
rtb-02b21534c3d314f1e
$ aws ec2 create-route \
    --profile b3-1 \
    --route-table-id rtb-02b21534c3d314f1e \
    --destination-cidr-block 0.0.0.0/0 \
    --gateway-id igw-011ba32fd601177ce
{
    "Return": true
}
$ aws ec2 associate-route-table \
    --profile b3-1 \
    --route-table-id rtb-02b21534c3d314f1e \
    --subnet-id subnet-076006b93227230ea
{
    "AssociationId": "rtbassoc-0fa8d7b66366482b8",
    "AssociationState": {
        "State": "associated"
    }
}

## 4. Security Group 생성과 인바운드 규칙
$ curl -s https://checkip.amazonaws.com
x.x.x.x
$ aws ec2 create-security-group \
    --profile b3-1 \
    --group-name b3-1-web-sg \
    --description "B3-1 web server: HTTP from anywhere, SSH from my IP" \
    --vpc-id vpc-0d4141c709a455f42 \
    --tag-specifications 'ResourceType=security-group,Tags=[{Key=Name,Value=b3-1-web-sg},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'GroupId' \
    --output text
sg-0e82ab4bd568d58f1
$ aws ec2 authorize-security-group-ingress \
    --profile b3-1 \
    --group-id sg-0e82ab4bd568d58f1 \
    --ip-permissions 'IpProtocol=tcp,FromPort=80,ToPort=80,IpRanges=[{CidrIp=0.0.0.0/0,Description="HTTP from anywhere"}]' \
    --query 'SecurityGroupRules[].[IsEgress,IpProtocol,FromPort,ToPort,CidrIpv4]' \
    --output table
|  False|  tcp |  80 |  80 |  0.0.0.0/0   |
$ aws ec2 authorize-security-group-ingress \
    --profile b3-1 \
    --group-id sg-0e82ab4bd568d58f1 \
    --ip-permissions 'IpProtocol=tcp,FromPort=22,ToPort=22,IpRanges=[{CidrIp=x.x.x.x/32,Description="SSH from my IP only"}]' \
    --query 'SecurityGroupRules[].[IsEgress,IpProtocol,FromPort,ToPort,CidrIpv4]' \
    --output table
|  False|  tcp |  22 |  22 |  x.x.x.x/32   |
$ aws ec2 describe-security-group-rules \
    --profile b3-1 \
    --filters Name=group-id,Values=sg-0e82ab4bd568d58f1 \
    --query 'SecurityGroupRules[].[IsEgress,IpProtocol,FromPort,ToPort,CidrIpv4]' \
    --output table
|  True |  -1  |  -1 |  -1 |  0.0.0.0/0           |
|  False|  tcp |  80 |  80 |  0.0.0.0/0           |
|  False|  tcp |  22 |  22 |  x.x.x.x/32   |
# 캡처: docs/screenshots/sg-rules-masked.png (IP 가림 · 원본은 mission_docs/private-screenshots/sg-rules.png, 제출 제외)

## 5. 키페어, AMI, EC2 생성
$ mkdir -p ~/.ssh && \
  aws ec2 create-key-pair \
    --profile b3-1 \
    --key-name b3-1-key \
    --key-type ed25519 \
    --tag-specifications 'ResourceType=key-pair,Tags=[{Key=Name,Value=b3-1-key},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'KeyMaterial' \
    --output text > ~/.ssh/b3-1-key.pem && \
  chmod 400 ~/.ssh/b3-1-key.pem && \
  ls -l ~/.ssh/b3-1-key.pem
# (보고) -r-------- ... /Users/heoney/.ssh/b3-1-key.pem  (개인키 내용은 기록하지 않음)
$ aws ec2 describe-images \
    --profile b3-1 \
    --owners amazon \
    --filters 'Name=name,Values=al2023-ami-2023.*-x86_64' 'Name=state,Values=available' \
    --query 'sort_by(Images,&CreationDate)[-1].[ImageId,Name,CreationDate]' \
    --output table
|  ami-0b8d35c42668c50d7                            |
|  al2023-ami-2023.12.20261109.0-kernel-6.1-x86_64  |
|  2026-11-04T23:29:36.000Z                         |
$ aws ec2 run-instances \
    --profile b3-1 \
    --image-id ami-0b8d35c42668c50d7 \
    --instance-type t3.micro \
    --count 1 \
    --key-name b3-1-key \
    --network-interfaces 'DeviceIndex=0,SubnetId=subnet-076006b93227230ea,Groups=sg-0e82ab4bd568d58f1,AssociatePublicIpAddress=true' \
    --block-device-mappings 'DeviceName=/dev/xvda,Ebs={VolumeSize=8,VolumeType=gp3,DeleteOnTermination=true}' \
    --credit-specification CpuCredits=standard \
    --tag-specifications \
      'ResourceType=instance,Tags=[{Key=Name,Value=b3-1-web},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
      'ResourceType=volume,Tags=[{Key=Name,Value=b3-1-web-root},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
      'ResourceType=network-interface,Tags=[{Key=Name,Value=b3-1-web-eni},{Key=Project,Value=Codyssey-B3-1},{Key=Owner,Value=Yeonjin_IAM}]' \
    --query 'Instances[0].[InstanceId,State.Name,InstanceType,PrivateIpAddress]' \
    --output text
i-01f7d473b859da5c4     pending t3.micro        10.0.1.14

